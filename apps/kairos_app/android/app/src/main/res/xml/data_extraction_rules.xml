<?xml version="1.0" encoding="utf-8"?>
<!-- Journal et progression : aucune sauvegarde cloud ni transfert automatique.
     Avec une base chiffree, une copie sans la cle du Keystore serait inutilisable
     de toute facon ; on evite aussi de sortir les donnees de l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
